{
  "expo": {
    "name": "E-Learning",
    "slug": "e-learning",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "elearning",
    "primaryColor": "#00BDD6",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#08080C",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.elearning.mobile"
    },
    "android": {
      "package": "com.elearning.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#00BDD6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "E-Learning",
      "shortName": "E-Learning",
      "description": "Learn online: browse courses, watch video lessons, ask questions and track your progress.",
      "lang": "en",
      "themeColor": "#08080C",
      "backgroundColor": "#08080C",
      "display": "standalone",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08080C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-sharing",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow E-Learning to access your photos to choose an avatar or project cover."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "618bce0a-ec57-42c2-a569-a58552bd892a"
      }
    },
    "owner": "kanele2602"
  }
}
