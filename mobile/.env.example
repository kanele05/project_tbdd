# Copy to .env and set your machine's LAN IP (NOT localhost when running on a real phone).
# Android emulator: http://10.0.2.2:4000/api/v1
EXPO_PUBLIC_API_URL=http://192.168.x.x:4000/api/v1

# Cloudflare Turnstile (CAPTCHA at sign-up / forgot-password / after repeated login failures).
# Unset = Cloudflare's test key "1x00000000000000000000AA" (always passes; dev only).
# EXPO_PUBLIC_TURNSTILE_SITE_KEY=
# Native only: hostname the CAPTCHA WebView claims to be served from. Must be in the site key's
# domain list. Unset = the origin of EXPO_PUBLIC_API_URL.
# EXPO_PUBLIC_TURNSTILE_BASE_URL=https://elearning.example.com
