{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.10:4000/api/v1",
        "EXPO_PUBLIC_TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.eliuh.site/api/v1",
        "EXPO_PUBLIC_CAPTCHA_PROVIDER": "recaptcha_v2",
        "EXPO_PUBLIC_RECAPTCHA_SITE_KEY": "6LeOgeUtAAAAAI0rBQtZ-MXl6II_Ah34OpWt5C5w",
        "EXPO_PUBLIC_RECAPTCHA_BASE_URL": "https://app.eliuh.site"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.eliuh.site/api/v1",
        "EXPO_PUBLIC_CAPTCHA_PROVIDER": "recaptcha_v2",
        "EXPO_PUBLIC_RECAPTCHA_SITE_KEY": "6LeOgeUtAAAAAI0rBQtZ-MXl6II_Ah34OpWt5C5w",
        "EXPO_PUBLIC_RECAPTCHA_BASE_URL": "https://app.eliuh.site"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
