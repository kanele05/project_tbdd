# =============================================================================
# E-Learning - cấu hình triển khai (Docker Compose trên VPS)
#
#   cp .env.example .env        # rồi sửa .env (KHÔNG commit .env - đã nằm trong .gitignore)
#   docker compose up -d
#
# - Ô để TRỐNG và có chữ "BẮT BUỘC" -> docker compose sẽ dừng và báo biến nào còn thiếu.
# - Tạo chuỗi bí mật:  openssl rand -hex 32     (mật khẩu/token: chỉ gồm 0-9 a-f nên không dính ký tự đặc biệt)
# - Giá trị có khoảng trắng hoặc dấu < > thì bọc trong "...". KHÔNG dùng ký tự $ trong giá trị.
# - Toàn bộ file này chỉ chứa GIÁ TRỊ MẪU / để trống. Bí mật thật chỉ nằm trong .env trên VPS.
# =============================================================================

# --- Tên miền & HTTPS (Caddy) --------------------------------------------------
# Tên miền gốc, không có http:// và không có dấu / ở cuối. Ví dụ: elearning-demo.xyz
# Caddy tự xin chứng chỉ HTTPS cho: <DOMAIN>, app.<DOMAIN>, api.<DOMAIN>, grafana.<DOMAIN>
# -> cần tạo bản ghi DNS A cho cả 4 tên này trỏ về IP của VPS (xem README mục 5).
# >>> BẮT BUỘC phải điền
DOMAIN=
# Email nhận thông báo của Let's Encrypt (chứng chỉ sắp hết hạn...).
# >>> BẮT BUỘC phải điền
ACME_EMAIL=
# Máy chủ cấp chứng chỉ. Mặc định là Let's Encrypt thật. Khi thử nghiệm DNS/cấu hình, đổi sang môi trường staging
# để không bị giới hạn số lần xin (chứng chỉ staging sẽ bị trình duyệt báo "không tin cậy"):
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# --- Image Docker (GitHub Container Registry) ----------------------------------
# Tài khoản/tổ chức GitHub chủ repo, viết THƯỜNG. Image: ghcr.io/<GHCR_OWNER>/elearning-api và elearning-web
GHCR_OWNER=kanele05
# Phiên bản chạy: latest (mới nhất của nhánh main), sha-xxxxxxx (một commit) hoặc 1.0.0 (tag v1.0.0).
# Muốn quay về bản cũ (rollback): đặt IMAGE_TAG=sha-xxxxxxx rồi chạy ./scripts/deploy.sh
IMAGE_TAG=latest

# --- Dịch vụ tùy chọn (profile) -------------------------------------------------
# mail   = Mailpit, hộp thư GIẢ chỉ để thử trên staging (đặt kèm SMTP_HOST=mailpit, SMTP_PORT=1025)
# status = Uptime Kuma (trang theo dõi uptime, cần thêm caddy/sites/status.caddy)
# Ví dụ: COMPOSE_PROFILES=mail,status      Production thật: để trống.
COMPOSE_PROFILES=

# --- PostgreSQL ---------------------------------------------------------------
# DATABASE_URL KHÔNG cần đặt: docker-compose tự ghép từ 3 biến dưới đây
# (postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB).
POSTGRES_USER=elearning
POSTGRES_DB=elearning
# Chỉ dùng 0-9 a-f (openssl rand -hex 24) để mật khẩu nằm gọn trong URL kết nối.
# >>> BẮT BUỘC phải điền
POSTGRES_PASSWORD=

# --- API: xác thực -------------------------------------------------------------
# Khóa ký JWT, tối thiểu 32 ký tự. Đổi khóa = mọi người dùng bị đăng xuất.
# >>> BẮT BUỘC phải điền (openssl rand -hex 32)
JWT_SECRET=
# Access token sống ngắn, refresh token sống dài (định dạng 15m, 12h, 30d).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# (Cũ) thời hạn JWT một-token của bản trước khi có refresh token; sẽ bị bỏ khi AUTH-01 hoàn tất.
# JWT_EXPIRES_IN=7d
# Khóa AES-256 mã hóa secret 2FA (TOTP) trong database: đúng 32 byte mã hóa base64.
# TUYỆT ĐỐI không đổi sau khi đã có người bật 2FA (đổi = không ai đăng nhập 2FA được nữa) và phải sao lưu ở nơi an toàn.
# >>> BẮT BUỘC phải điền (openssl rand -base64 32)
TOTP_ENC_KEY=
# Mức log của API: error | warn | info | debug
LOG_LEVEL=info

# --- API: URL công khai ----------------------------------------------------------
# Chỉ đặt nếu API không nằm ở https://api.<DOMAIN> (mặc định đã đúng).
# PUBLIC_BASE_URL=https://api.example.com

# --- Gửi email (xác minh email, quên mật khẩu) ------------------------------------
# SMTP_HOST để trống -> API KHÔNG gửi email thật, chỉ ghi nội dung thư ra log (người dùng sẽ không nhận được mã OTP!).
# Production dùng Brevo hoặc Resend (README mục 12). Brevo: smtp-relay.brevo.com / 587.  Resend: smtp.resend.com / 587.
SMTP_HOST=
SMTP_PORT=587
# Brevo: email đăng nhập SMTP + SMTP key (không phải mật khẩu tài khoản).  Resend: USER=resend, PASS=API key (re_...).
SMTP_USER=
SMTP_PASS=
# Địa chỉ người gửi. Phải thuộc tên miền đã xác minh ở nhà cung cấp SMTP (SPF/DKIM) để thư không rơi vào spam.
MAIL_FROM="E-Learning <no-reply@example.com>"

# --- CAPTCHA Cloudflare Turnstile ------------------------------------------------
# Tạo widget tại dash.cloudflare.com -> Turnstile (README mục 11). Hostname của widget: <DOMAIN> và app.<DOMAIN>.
# Site key là công khai (nhúng vào bản web ở bước build); Secret key là bí mật (chỉ API dùng).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Chỉ để thử: key test của Cloudflare luôn "pass" (KHÔNG dùng cho production):
#   site 1x00000000000000000000AA  |  secret 1x0000000000000000000000000000000AA

# --- AI (Google Gemini, gói miễn phí) ----------------------------------------------
# Key lấy tại https://aistudio.google.com/apikey. Để trống -> chế độ "mock" (câu trả lời giả, app vẫn chạy).
AI_PROVIDER=
GEMINI_API_KEY=
# Model Gemini. gemini-3.5-flash-lite có hạn mức free tier lớn nhất; muốn chất lượng cao hơn: gemini-3.8-flash.
GEMINI_MODEL=gemini-3.5-flash-lite
# Thời gian chờ tối đa cho một lần gọi AI (mili-giây).
AI_TIMEOUT_MS=45000
# Hạn mức giúp không chạm trần free tier của Google (vượt hạn mức -> API trả 429 AI_RATE_LIMITED).
# Theo giờ, mỗi người dùng: AI Tutor (chat) tính riêng; tóm tắt/quiz/gợi ý dùng chung một bộ đếm.
AI_CHAT_LIMIT_PER_HOUR=20
AI_LIMIT_PER_HOUR=30
# Theo ngày: mỗi người dùng (gộp mọi tính năng AI) và toàn server (chỉ áp dụng khi dùng gemini thật).
AI_USER_LIMIT_PER_DAY=60
AI_GLOBAL_LIMIT_PER_DAY=400

# --- Monitoring ---------------------------------------------------------------------
# /metrics của API chạy trên cổng nội bộ 9464 (không publish ra Internet). Muốn thêm một lớp bảo vệ nữa:
# đặt METRICS_TOKEN (>= 16 ký tự) rồi làm theo hướng dẫn trong deploy/prometheus/prometheus.yml (mục job api).
METRICS_TOKEN=
# Tài khoản quản trị Grafana (đăng nhập tại https://grafana.<DOMAIN>). Hãy đổi mật khẩu ngay lần đăng nhập đầu tiên.
GRAFANA_ADMIN_USER=admin
# >>> BẮT BUỘC phải điền (openssl rand -hex 16)
GRAFANA_ADMIN_PASSWORD=

# --- Sao lưu database (container "backup") --------------------------------------------
# Giữ bao nhiêu bản sao lưu mới nhất trong deploy/backups/ (mỗi ngày 1 bản).
BACKUP_KEEP=7
# Giờ chạy sao lưu (giờ UTC). 20 = 03:00 sáng giờ Việt Nam.
BACKUP_HOUR_UTC=20
