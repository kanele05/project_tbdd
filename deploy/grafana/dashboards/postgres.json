        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (state) (pg_stat_activity_count{job=\"postgres\",datname=~\"$db\"})",
          "legendFormat": "{{state}}",
