' =============================================================================
' E-Learning App — Use Case Diagram (PlantUML)
' Task R-03 (PLAN §13) · Nguồn: PLAN §6.1 (Actor), §6.2 (21 Use case)
'
' File chứa 4 sơ đồ (mỗi khối @startuml ... @enduml xuất ra một file PNG cùng tên):
'   1. use-case                         — Tổng quan 21 UC, 4 actor
'   2. use-case-account-profile         — Nhóm Tài khoản + Hồ sơ (UC-01..03, UC-18..20)
'   3. use-case-discovery-purchase      — Nhóm Khám phá + Mua và ghi danh (UC-04..12)
'   4. use-case-learning-interaction    — Nhóm Học tập + Tương tác (UC-08, 13..17, 21)
'
' Quy ước màu (theo ưu tiên MoSCoW của PLAN §6.2):
'   Xanh nhạt = Must · Tím nhạt = Should · Xám = Could · Vàng nhạt = chức năng dùng chung
' Hướng dẫn xuất PNG: xem README.md cùng thư mục.
' =============================================================================

@startuml use-case
title E-Learning App — Use Case Diagram tổng quan (21 use case)

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam roundCorner 12
skinparam ArrowColor #565E6C
skinparam ActorBorderColor #171A1F
skinparam ActorBackgroundColor #FFFFFF
skinparam PackageBorderColor #9095A0
skinparam PackageBackgroundColor #FFFFFF
skinparam RectangleBorderColor #171A1F
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #565E6C
  BackgroundColor<<Must>> #EBFDFF
  BorderColor<<Must>> #00BDD6
  BackgroundColor<<Should>> #EEE8FB
  BorderColor<<Should>> #8353E2
  BackgroundColor<<Could>> #F3F4F6
  BorderColor<<Could>> #9095A0
  BackgroundColor<<Shared>> #FFF8E1
  BorderColor<<Shared>> #ED7D2D
}

actor "Guest\n(Chưa đăng nhập)" as Guest
actor "Learner\n(Học viên)" as Learner
actor "Teacher\n(Giảng viên)" as Teacher
actor "Payment Gateway\n(giả lập)" as PG <<System>>

rectangle "E-Learning App (Mobile + REST API)" {

  package "Tài khoản" {
    usecase "UC-01\nĐăng ký tài khoản" as UC01 <<Must>>
    usecase "UC-02\nĐăng nhập" as UC02 <<Must>>
    usecase "UC-03\nĐăng xuất" as UC03 <<Must>>
  }

  package "Khám phá" {
    usecase "UC-04\nXem trang chủ" as UC04 <<Must>>
    usecase "UC-05\nTìm kiếm khóa học" as UC05 <<Must>>
    usecase "UC-06\nLọc và sắp xếp kết quả" as UC06 <<Should>>
    usecase "UC-07\nDuyệt khóa học theo\ndanh mục / nhóm" as UC07 <<Must>>
    usecase "UC-08\nXem chi tiết khóa học" as UC08 <<Must>>
    usecase "UC-09\nXem trước bài học\nmiễn phí (preview)" as UC09 <<Must>>
    usecase "UC-10\nLưu / bỏ lưu khóa học" as UC10 <<Must>>
  }

  package "Mua và ghi danh" {
    usecase "UC-11\nQuản lý giỏ hàng" as UC11 <<Must>>
    usecase "UC-12\nThanh toán và ghi danh" as UC12 <<Must>>
  }

  package "Học tập" {
    usecase "UC-13\nXem khóa học của tôi" as UC13 <<Must>>
    usecase "UC-14\nHọc bài qua video\nvà lưu tiến độ" as UC14 <<Must>>
  }

  package "Tương tác" {
    usecase "UC-15\nĐánh giá khóa học" as UC15 <<Should>>
    usecase "UC-16\nHỏi đáp (Q&A)" as UC16 <<Should>>
    usecase "UC-17\nNộp project và\ntải tài liệu" as UC17 <<Should>>
    usecase "UC-21\nThích / chia sẻ khóa học" as UC21 <<Could>>
  }

  package "Hồ sơ" {
    usecase "UC-18\nXem hồ sơ giảng viên\nvà theo dõi (Follow)" as UC18 <<Should>>
    usecase "UC-19\nXem và chỉnh sửa\nhồ sơ cá nhân" as UC19 <<Must>>
    usecase "UC-20\nXem thông báo" as UC20 <<Should>>
  }

  package "Chức năng dùng chung (không đánh số UC)" {
    usecase "Xác thực phiên\n(kiểm tra JWT Bearer)" as AUTH <<Shared>>
    usecase "Kiểm tra quyền ghi danh\n(BR-01, BR-08, BR-09)" as ENR <<Shared>>
  }
}

' ---- Guest ----
Guest -- UC01
Guest -- UC02

' ---- Learner ----
Learner -- UC03
Learner -- UC04
Learner -- UC05
Learner -- UC06
Learner -- UC07
Learner -- UC08
Learner -- UC09
Learner -- UC10
Learner -- UC11
Learner -- UC12
Learner -- UC13
Learner -- UC14
Learner -- UC15
Learner -- UC16
Learner -- UC17
Learner -- UC18
Learner -- UC19
Learner -- UC20
Learner -- UC21

' ---- Teacher (actor phụ: sở hữu khóa học, được follow / đánh giá; dữ liệu do seed) ----
UC08 -- Teacher
UC15 -- Teacher
UC18 -- Teacher

' ---- Payment Gateway giả lập ----
UC12 -- PG

' ---- Quan hệ include ----
UC10 ..> AUTH : <<include>>
UC11 ..> AUTH : <<include>>
UC12 ..> AUTH : <<include>>
UC13 ..> AUTH : <<include>>
UC19 ..> AUTH : <<include>>
UC20 ..> AUTH : <<include>>
ENR ..> AUTH : <<include>>
UC14 ..> ENR : <<include>>
UC15 ..> ENR : <<include>>
UC16 ..> ENR : <<include>>
UC17 ..> ENR : <<include>>

' ---- Quan hệ extend (mũi tên từ UC mở rộng tới UC cơ sở) ----
UC06 ..> UC05 : <<extend>>
UC09 ..> UC08 : <<extend>>
UC10 ..> UC08 : <<extend>>
UC15 ..> UC08 : <<extend>>
UC12 ..> UC11 : <<extend>>
UC16 ..> UC14 : <<extend>>
UC17 ..> UC14 : <<extend>>
UC21 ..> UC14 : <<extend>>

note right of UC12
  Khóa miễn phí (giá 0): nút "Enroll for free"
  ghi danh trực tiếp, không qua giỏ hàng
  và không gọi Payment Gateway.
end note

note right of AUTH
  Mọi UC của Learner (trừ UC-01, UC-02)
  yêu cầu phiên hợp lệ (JWT Bearer).
  UC-01 tự đăng nhập sau khi đăng ký thành công.
end note

note bottom of UC10
  UC-10 thao tác được trên mọi card khóa học
  (UC-04, UC-05, UC-07, UC-13, UC-18, UC-19).
end note

legend right
  <b>Màu theo ưu tiên (MoSCoW)</b>
  <color:#00BDD6><b>Xanh</b></color> = Must
  <color:#8353E2><b>Tím</b></color> = Should
  <color:#9095A0><b>Xám</b></color> = Could
  <color:#ED7D2D><b>Cam</b></color> = Chức năng dùng chung
end legend

@enduml


