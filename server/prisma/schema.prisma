// Prisma schema — theo PLAN.md §8.2 (Prisma 7: generator `prisma-client`, URL kết nối nằm ở prisma.config.ts).
// Mọi thay đổi schema phải qua `npm run db:migrate -- --name <ten>` và cập nhật PLAN.md §8.2.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

enum NotificationType {
  ORDER_PAID
  NEW_ANSWER
  COURSE_COMPLETED
  SYSTEM
}

enum BannerTarget {
  COURSE
  CATEGORY
}

enum AiContentKind {
  COURSE_SUMMARY
  LESSON_SUMMARY
  RECOMMENDATIONS
  QUIZ
}

enum AiChatRole {
  USER
  ASSISTANT
}

// Mục đích của mã OTP 6 số gửi qua email (AUTH-02, AUTH-03).
enum OneTimeCodePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// Nhật ký bảo mật (AUTH-06). Chỉ ghi sự kiện của tài khoản có thật (không lưu email người lạ thử đăng nhập).
enum AuthEventType {
  REGISTER
  EMAIL_VERIFIED
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_LOCKED
  NEW_DEVICE_LOGIN
  LOGOUT
  SESSION_REVOKED
  REFRESH_REUSE
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET
  PASSWORD_CHANGED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  TWO_FACTOR_FAILED
  RECOVERY_CODE_USED
  RECOVERY_CODES_REGENERATED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  headline     String?
  avatarUrl    String?
  coverUrl     String?
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- Bảo mật tài khoản (AUTH-01…AUTH-06) ---
  // null = chưa xác minh email (chưa đăng nhập được).
  emailVerifiedAt  DateTime?
  // Số lần sai liên tiếp (mật khẩu hoặc mã 2FA); về 0 khi đăng nhập thành công / khi bị khóa.
  failedLoginCount Int       @default(0)
  // Khóa đăng nhập tới thời điểm này (sau 5 lần sai).
  lockedUntil      DateTime?
  // Secret TOTP đã mã hóa AES-256-GCM ("v1.<iv>.<tag>.<ciphertext>"); có giá trị từ lúc /me/2fa/setup.
  totpSecretEnc    String?
  // null = 2FA chưa bật (secret mới chỉ là bản chờ xác nhận).
  totpEnabledAt    DateTime?
  // Bước thời gian (unix / 30 s) của mã TOTP đã dùng gần nhất - chặn dùng lại cùng một mã.
  totpLastStep     Int?

  teacherProfile TeacherProfile?
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  bookmarks      Bookmark[]
  courseLikes    CourseLike[]
  cartItems      CartItem[]
  orders         Order[]
  reviews        Review[]
  questions      Question[]
  answers        Answer[]
  questionLikes  QuestionLike[]
  submissions    ProjectSubmission[]
  notifications  Notification[]
  follows        Follow[]
  aiChatMessages AiChatMessage[]
  sessions       Session[]
  oneTimeCodes   OneTimeCode[]
  recoveryCodes  RecoveryCode[]
  authEvents     AuthEvent[]
}

model TeacherProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  jobTitle     String
  bio          String
  organization String?
  location     String?
  timezone     String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses   Course[]
  followers Follow[]
}

model Follow {
  userId    String
  teacherId String
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([userId, teacherId])
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  icon    String
  color   String
  order   Int      @default(0)
  courses Course[]
}

model Tag {
  id      String      @id @default(cuid())
  name    String      @unique
  isHot   Boolean     @default(false)
  courses CourseTag[]
}

model CourseTag {
  courseId String
  tagId    String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([courseId, tagId])
}

model Course {
  id                 String   @id @default(cuid())
  title              String
  subtitle           String?
  description        String
  thumbnailUrl       String
  bannerUrl          String?
  priceCents         Int
  originalPriceCents Int?
  benefits           String[]
  projectDescription String?
  isBestSeller       Boolean  @default(false)
  isFeatured         Boolean  @default(false)
  isPublished        Boolean  @default(true)
  ratingAvg          Float    @default(0)
  ratingCount        Int      @default(0)
  enrollmentCount    Int      @default(0)
  likeCount          Int      @default(0)
  shareCount         Int      @default(0)
  lessonCount        Int      @default(0)
  totalDurationSec   Int      @default(0)
  categoryId         String
  teacherId          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  category       Category            @relation(fields: [categoryId], references: [id])
  teacher        TeacherProfile      @relation(fields: [teacherId], references: [id])
  tags           CourseTag[]
  sections       Section[]
  enrollments    Enrollment[]
  bookmarks      Bookmark[]
  likes          CourseLike[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  reviews        Review[]
  questions      Question[]
  resources      Resource[]
  submissions    ProjectSubmission[]
  aiChatMessages AiChatMessage[]

  @@index([categoryId])
  @@index([teacherId])
  @@index([enrollmentCount])
  @@index([ratingAvg])
  @@index([createdAt])
}

model Section {
  id       String @id @default(cuid())
  courseId String
  title    String
  order    Int

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, order])
}

model Lesson {
  id          String  @id @default(cuid())
  sectionId   String
  title       String
  order       Int
  durationSec Int
  videoUrl    String
  isPreview   Boolean @default(false)
  // Ghi chú / nội dung chữ của bài - nguồn cho tính năng AI (video mẫu không có transcript).
  content     String?

  section  Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@unique([sectionId, order])
}

model Enrollment {
  id              String    @id @default(cuid())
  userId          String
  courseId        String
  progressPercent Int       @default(0)
  lastLessonId    String?
  lastAccessedAt  DateTime  @default(now())
  enrolledAt      DateTime  @default(now())
  completedAt     DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, lastAccessedAt])
}

model LessonProgress {
  userId      String
  lessonId    String
  positionSec Int      @default(0)
  isCompleted Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
}

model Bookmark {
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
}

model CourseLike {
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
}

model CartItem {
  userId   String
  courseId String
  addedAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  totalCents    Int
  status        OrderStatus @default(PENDING)
  paymentMethod String
  createdAt     DateTime    @default(now())
  paidAt        DateTime?

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([userId, createdAt])
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  courseId   String
  priceCents Int

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id])

  @@unique([orderId, courseId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, rating])
}

model Question {
  id          String   @id @default(cuid())
  courseId    String
  userId      String
  content     String
  likeCount   Int      @default(0)
  answerCount Int      @default(0)
  createdAt   DateTime @default(now())

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers Answer[]
  likes   QuestionLike[]

  @@index([courseId, createdAt])
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  content    String
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId, createdAt])
}

model QuestionLike {
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
}

model Resource {
  id        String @id @default(cuid())
  courseId  String
  name      String
  fileUrl   String
  sizeBytes Int
  mimeType  String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model ProjectSubmission {
  id          String   @id @default(cuid())
  courseId    String
  userId      String
  title       String
  description String?
  imageUrl    String?
  fileUrl     String
  createdAt   DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
}

model Banner {
  id         String       @id @default(cuid())
  title      String
  subtitle   String?
  ctaText    String
  imageUrl   String
  bgColor    String
  targetType BannerTarget
  targetId   String
  order      Int          @default(0)
  isActive   Boolean      @default(true)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

// Cache kết quả AI (tóm tắt khóa/bài, quiz, gợi ý). `refId` là courseId / lessonId / userId tùy `kind`
// (không có FK vì tham chiếu nhiều bảng) -> seed phải xóa bảng này khi xóa dữ liệu gốc.
model AiContent {
  id        String        @id @default(cuid())
  kind      AiContentKind
  refId     String
  lang      String        @default("en")
  content   Json
  model     String
  createdAt DateTime      @default(now())
  expiresAt DateTime?

  @@unique([kind, refId, lang])
}

// Lịch sử hội thoại AI Tutor của một học viên trong một khóa học.
model AiChatMessage {
  id        String     @id @default(cuid())
  userId    String
  courseId  String
  role      AiChatRole
  content   String
  createdAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, courseId, createdAt])
}

// ---------------------------------------------------------------- Xác thực (AUTH-01…AUTH-06)

// Một lần đăng nhập trên một thiết bị. `id` chính là claim `sid` trong access token; thu hồi phiên
// (`revokedAt`) làm mọi access token của phiên đó bị từ chối ngay.
model Session {
  id            String    @id @default(cuid())
  userId        String
  deviceName    String
  userAgent     String?
  // Đã rút gọn khi lưu (vd. "113.161.45.x"), không lưu IP đầy đủ.
  ipAddress     String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  // Hạn của refresh token mới nhất (trượt theo mỗi lần refresh).
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
}

// Refresh token xoay vòng: mỗi lần refresh đánh dấu token cũ `usedAt` và cấp token mới cùng `sessionId`.
// Chỉ lưu SHA-256 của token. Token đã dùng mà bị trình lại = bị đánh cắp -> thu hồi cả phiên.
model RefreshToken {
  id        String    @id @default(cuid())
  sessionId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, usedAt])
}

// Mã OTP 6 số (HMAC, không lưu thô). Mỗi (user, purpose) chỉ có một mã còn hiệu lực: cấp mã mới xóa mã cũ.
model OneTimeCode {
  id         String             @id @default(cuid())
  userId     String
  purpose    OneTimeCodePurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int                @default(0)
  consumedAt DateTime?
  createdAt  DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

// Mã khôi phục 2FA (dùng một lần, lưu HMAC).
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
}

model AuthEvent {
  id        String        @id @default(cuid())
  userId    String
  type      AuthEventType
  sessionId String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}
