# Sao chép file này thành `.env` rồi chỉnh sửa. KHÔNG commit `.env`.
NODE_ENV=development
PORT=4000

# PostgreSQL local (npm run db:start) — đổi sang Neon chỉ cần thay chuỗi này
# (Neon: postgresql://USER:PASSWORD@HOST/DB?sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/elearning?schema=public

# Chuỗi ngẫu nhiên >= 32 ký tự (mỗi người tự tạo, ví dụ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

CORS_ORIGIN=*

# URL tuyệt đối (IP LAN của máy chạy server) để tạo link file static/upload cho điện thoại
PUBLIC_BASE_URL=http://localhost:4000
UPLOAD_DIR=uploads

# --- AI (Google Gemini, gói miễn phí của Google AI Studio) ---
# Để trống GEMINI_API_KEY -> chạy chế độ "mock" (nội dung AI giả, deterministic) - app vẫn dùng được.
# Lấy key miễn phí tại https://aistudio.google.com/apikey rồi dán vào .env (KHÔNG commit .env).
AI_PROVIDER=
GEMINI_API_KEY=
# Model free tier: gemini-3.5-flash-lite (stable, Google khuyến nghị cho dự án mới; free tier ~500 request/ngày
# cho cả project - Google không công bố số cụ thể, xem trong AI Studio). Muốn chất lượng cao hơn: gemini-3.8-flash
# (free tier chỉ ~20 request/ngày). Danh sách model: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=45000
# Rate limit theo user (request / giờ): chat riêng, tóm tắt + quiz + gợi ý dùng chung
AI_CHAT_LIMIT_PER_HOUR=20
AI_LIMIT_PER_HOUR=30
# Trần mỗi ngày: theo user (mọi tính năng AI cộng dồn) và cho cả server (chỉ áp dụng khi dùng gemini).
# Free tier tính theo PROJECT nên AI_GLOBAL_LIMIT_PER_DAY phải thấp hơn hạn mức/ngày của model.
AI_USER_LIMIT_PER_DAY=60
AI_GLOBAL_LIMIT_PER_DAY=400

# --- Prometheus metrics (monitoring) ---
# Để trống METRICS_PORT -> KHÔNG phục vụ /metrics. Đặt cổng (vd 9464) -> /metrics chạy trên cổng RIÊNG này,
# tách khỏi cổng API công khai (PORT). Cổng này KHÔNG được publish ra Internet (xem deploy/README.md).
METRICS_PORT=
# Mặc định nghe localhost. Trong Docker đặt 0.0.0.0 để Prometheus (cùng mạng nội bộ) scrape được.
METRICS_HOST=127.0.0.1
# (Tùy chọn, >= 16 ký tự) nếu đặt thì /metrics yêu cầu header "Authorization: Bearer <token>".
METRICS_TOKEN=

# --- Gửi email (xác minh email OTP, quên mật khẩu) ---
# Dev: chạy Mailpit (hộp thư giả, KHÔNG gửi ra ngoài) - xem deploy/README.md:
#   docker run -p 1025:1025 -p 8025:8025 axllent/mailpit   -> đọc thư tại http://localhost:8025
# Không có Docker/Mailpit: để TRỐNG SMTP_HOST -> API chỉ ghi nội dung thư ra log (dev đọc mã OTP trong log của `npm run dev`).
# Production: dùng SMTP thật (Brevo/Resend...) - xem deploy/README.md mục "Nhà cung cấp SMTP".
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="E-Learning <no-reply@example.com>"

# --- CAPTCHA Cloudflare Turnstile ---
# Dev: dùng KEY TEST chính thức của Cloudflare (luôn pass), không cần tài khoản:
#   site key 1x00000000000000000000AA | secret key 1x0000000000000000000000000000000AA
#   (luôn fail: 2x00000000000000000000AB / 2x0000000000000000000000000000000AA)
# Production: tạo widget thật tại https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- 2FA TOTP ---
# Khóa AES-256 (32 byte, base64) để mã hóa secret TOTP trong DB. Sinh bằng:  openssl rand -base64 32
# Giá trị dưới đây là khóa DEV (32 byte toàn số 0, đúng định dạng nhưng KHÔNG an toàn) - chỉ để chạy local.
# Production/staging phải tự sinh khóa riêng, KHÔNG dùng lại giữa các môi trường.
TOTP_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- Thời hạn token ---
# Access token 15 phút + refresh token 30 ngày. Khi app mobile CHƯA tự refresh (trước AUTH-08) có thể đặt tạm
# ACCESS_TOKEN_TTL=7d trong .env của máy dev để app không bị đăng xuất sau 15 phút (KHÔNG dùng ở production).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
