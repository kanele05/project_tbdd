# Sao chép thành `.env.test`. DB RIÊNG cho test — dữ liệu bị xóa mỗi lần chạy `npm test`.
NODE_ENV=test
PORT=4001
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/elearning_test?schema=public
JWT_SECRET=test-secret-test-secret-test-secret-32chars
CORS_ORIGIN=*
PUBLIC_BASE_URL=http://localhost:4001
UPLOAD_DIR=uploads
# Test luôn dùng AI giả (không gọi Gemini)
AI_PROVIDER=mock
CAPTCHA_PROVIDER=turnstile
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
CAPTCHA_ALLOWED_HOSTNAMES=
